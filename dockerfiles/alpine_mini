FROM --platform=i386 i386/alpine:3.20

RUN apk add --no-cache bash coreutils mg doas mc bsd-games cmatrix sl figlet file lua txr && \
    apk add --no-cache --virtual .build-deps shadow && \
    addgroup user && \
    adduser -G user -s /bin/bash -D user && \
    echo "user:password" | chpasswd && \
    echo "root:password" | chpasswd && \
    echo "permit persist :user" > /etc/doas.d/doas.conf && \
    apk del .build-deps

WORKDIR /home/user/

RUN apk add --no-cache curl && \
    curl -fLo /usr/local/bin/melbi https://github.com/melbi-lang/melbi/releases/download/pre-alpha/melbi-i686-unknown-linux-musl && \
    chmod +x /usr/local/bin/melbi && \
    curl -fLo /usr/local/bin/genact https://github.com/NiltonVolpato/webvm/releases/download/genact-i686/genact && \
    chmod +x /usr/local/bin/genact && \
    apk del curl

COPY --chown=user:user image/home/ /home/user/
COPY image/bin/ /usr/local/bin/

ENV HOME="/home/user" TERM="xterm" USER="user" SHELL="/bin/bash" EDITOR="mg" LANG="en_US.UTF-8" LC_ALL="en_US.UTF-8"

USER user
CMD [ "/bin/bash" ]
